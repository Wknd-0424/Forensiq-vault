# ForensIQ Vault — Environment Variables Template
# Copy this file to .env and fill in values for your environment.
# NEVER commit the .env file to version control.
# NEVER put real credentials, RTSP URLs, or passwords in this file.

# Path to ffprobe executable.
# Leave empty to search system PATH (recommended).
# Windows example: FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
# Linux example:   FFPROBE_PATH=/usr/bin/ffprobe
FFPROBE_PATH=

# Maximum evidence file size in bytes.
# Default: 2147483648 = 2 GiB
MAX_EVIDENCE_SIZE_BYTES=2147483648

# Application log level: DEBUG, INFO, WARNING, ERROR
APP_LOG_LEVEL=INFO

# Optional: Override vault root path.
# Default: <project_root>/vault
# Use an absolute path if vault must be on a separate drive.
# Example: VAULT_ROOT=D:\ForensIQ_Vault
VAULT_ROOT=

# Optional: YOLO model weights path.
# Do NOT download models automatically.
# Download yolov8n.pt manually and set the path here.
# Example: YOLO_MODEL_PATH=C:\Users\username\models\yolov8n.pt
YOLO_MODEL_PATH=
